{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'workarounds:all',
    'helpers:pinGitHubActionDigests',
    'github>uncharted311/home-ops//.renovate/changelogs.json5',
    'github>uncharted311/home-ops//.renovate/groups.json5',
    'github>uncharted311/home-ops//.renovate/labels.json5',
    'github>uncharted311/home-ops//.renovate/semanticCommits.json5',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(Europe/Berlin)',
    ':prHourlyLimitNone',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  assignees: [
    'uncharted311',
  ],
  prConcurrentLimit: 30,
  pinDigests: false,
  ignorePaths: [
    '**/*.sops.*',
    '**/resources/**',
  ],
  enabledManagers: [
    'docker-compose',
    'dockerfile',
    'github-actions',
    'custom.regex',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Traefik plugins',
      managerFilePatterns: [
        '/\\.ya?ml$/',
        '/\\.toml$/',
      ],
      matchStrings: [
        'moduleName:\\s*["\']?github\\.com/(?<depName>[^"\'\\s]+)["\']?\\s*\\n\\s*version:\\s*["\']?(?<currentValue>[^"\'\\s]+)',
      ],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
      extractVersionTemplate: '^v?(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      description: 'Separate major container upgrades and prioritize them',
      matchDatasources: [
        'docker',
      ],
      separateMajorMinor: true,
      separateMultipleMajor: true,
      prPriority: 10,
    },
    {
      description: 'Automerge GitHub Actions digest/patch',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'digest',
        'patch',
      ],
      automerge: true,
    },
    {
      description: 'Clean versioning for all Linuxserver.io images (ignores -ls rebuild tags and historic Ubuntu/broken tags)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/^linuxserver\\//',
        '/^lscr\\.io\\/linuxserver\\//',
        '/^ghcr\\.io\\/linuxserver\\//',
      ],
      // Erlaubt KEINE -ls305 Suffixe mehr -> verhindert PRs wie 4.10.2 -> 4.10.2.0-ls305
      versioning: 'regex:^(?<compatibility>version-|v)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$',
      // Generischer Schutzfilter für alle LSIO-Container: Ignoriert Ubuntu-Releases (14.04, 20.04.1), Jahreszahlen (>20) und den kaputten 7.0.19 Build
      allowedVersions: '!/^(?:version-|v)?(?:7\\.0\\.19|14\\.|20\\.|[2-9]\\d\\.)/',
    },
    {
      description: 'Pangolin versioning (supports ee-postgresql-, ee-, postgresql- prefixes and ignores arch-specific tags)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'fosrl/pangolin',
        'ghcr.io/fosrl/pangolin',
      ],
      versioning: 'regex:^(?<compatibility>(?:ee-postgresql|ee|postgresql)-)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
  ],
}