port = {{ komodo_periphery_port }}
bind_ip = "0.0.0.0"
repo_dir = "{{ komodo_repo_dir }}"
stack_dir = "{{ komodo_stack_dir }}"
ssl_enabled = {{ komodo_ssl_enabled | lower }}

# Maximaler Lockdown: Nur GitOps-Compose-Deployments erlaubt
disable_terminals = true
disable_container_exec = true

allowed_ips = [
{% for ip in komodo_allowed_ips | default([]) %}
  "{{ ip }}",
{% endfor %}
]

core_public_keys = [
{% for key in komodo_core_public_keys %}
  "{{ key }}",
{% endfor %}
]
