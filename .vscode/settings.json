{
    /* SOPS & Grundlagen */
    "sops.binPath": "sops",
    "sops.configPath": "./.sops.yaml",
    "sops.creationEnabled": false,
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,

    /* Dateizuordnungen */
    "files.associations": {
        "*.sops.env": "dotenv",
        "*.sops.yml": "yaml",
        "*.sops.yaml": "yaml",
        "*.conf.template": "nginx",
        "*.conf": "nginx",
        "nginx.conf": "nginx",
        "secrets.env": "dotenv",
        "**/infrastructure/ansible/playbooks/*.yml": "ansible",
        "**/infrastructure/ansible/roles/**/tasks/*.yml": "ansible",
        "**/infrastructure/ansible/roles/**/handlers/*.yml": "ansible"
    },

    /* Sprachspezifische Einstellungen: YAML (SOPS-Schutz beim Speichern) */
    "[yaml]": {
        "editor.formatOnSave": false
    },

    /* Sprachspezifische Einstellungen: Dotenv (Secrets) */
    "[dotenv]": {
        "files.encoding": "utf8",
        "editor.formatOnSave": false
    },

    /* Sprachspezifische Einstellungen: Nginx (Templates) */
    "[nginx]": {
        "editor.defaultFormatter": "simonschneider.nginx-format",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        }
    },

    /* Linter-Integration */
    "ansible.validation.lint.enabled": false,
    "nginx.linter.enable": true,
    "nginx.linter.run": "onType"
}
