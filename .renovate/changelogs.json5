{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Changelog & Release Notes for Vansmak Episeerr",
      matchDatasources: ["docker"],
      matchPackageNames: ["vansmak/episeerr"],
      sourceUrl: "https://github.com/Vansmak/episeerr",
      changelogUrl: "https://github.com/Vansmak/episeerr/releases",
    },
    {
      description: "Changelog & Release Notes for qBittorrent (strips version-/release- prefix from LinuxServer/Hotio/Binhex tags)",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "lscr.io/linuxserver/qbittorrent",
        "linuxserver/qbittorrent",
        "ghcr.io/hotio/qbittorrent",
        "binhex/arch-qbittorrentvpn",
      ],
      sourceUrl: "https://github.com/qbittorrent/qBittorrent",
      changelogUrl: "https://www.qbittorrent.org/news",
      extractVersion: "^(?:version-|release-)?(?<version>\\d+\\.\\d+\\.\\d+)",
    },
    {
      description: "Changelog & Release Notes for Radarr (strips version- prefix from LinuxServer/Hotio tags)",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "lscr.io/linuxserver/radarr",
        "linuxserver/radarr",
        "ghcr.io/hotio/radarr",
      ],
      sourceUrl: "https://github.com/Radarr/Radarr",
      changelogUrl: "https://github.com/Radarr/Radarr/releases",
      extractVersion: "^(?:version-|release-)?(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)",
    },
    {
      description: "Changelog & Release Notes for Sonarr (strips version- prefix from LinuxServer/Hotio tags)",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "lscr.io/linuxserver/sonarr",
        "linuxserver/sonarr",
        "ghcr.io/hotio/sonarr",
      ],
      sourceUrl: "https://github.com/Sonarr/Sonarr",
      changelogUrl: "https://github.com/Sonarr/Sonarr/releases",
      extractVersion: "^(?:version-|release-)?(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)",
    },
    {
      description: "Changelog & Release Notes for Prowlarr (strips version- prefix from LinuxServer/Hotio tags)",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "lscr.io/linuxserver/prowlarr",
        "linuxserver/prowlarr",
        "ghcr.io/hotio/prowlarr",
      ],
      sourceUrl: "https://github.com/Prowlarr/Prowlarr",
      changelogUrl: "https://github.com/Prowlarr/Prowlarr/releases",
      extractVersion: "^(?:version-|release-)?(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)",
    },
    {
      description: "Changelog & Release Notes for Nginx",
      matchDatasources: ["docker"],
      matchPackageNames: ["nginx", "library/nginx"],
      sourceUrl: "https://github.com/nginx/nginx",
      changelogUrl: "https://nginx.org/en/CHANGES",
      extractVersion: "^(?<version>\\d+\\.\\d+\\.\\d+)",
    },
    {
      description: "Official Release Notes link for PostgreSQL (PostgreSQL does not use GitHub Releases)",
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres", "library/postgres"],
      changelogUrl: "https://www.postgresql.org/docs/release/",
    },
    {
      description: "Changelog & Release Notes for Redis (points from docker-library to official redis repo)",
      matchDatasources: ["docker"],
      matchPackageNames: ["redis", "library/redis"],
      sourceUrl: "https://github.com/redis/redis",
      extractVersion: "^(?<version>\\d+\\.\\d+\\.\\d+)",
    },
    {
      description: "Changelog & Release Notes for Fossorial Pangolin (strips ee-postgresql- prefix to match GitHub release tags)",
      matchDatasources: ["docker"],
      matchPackageNames: ["fosrl/pangolin", "ghcr.io/fosrl/pangolin"],
      sourceUrl: "https://github.com/fosrl/pangolin",
      extractVersion: "^(?:ee-postgresql-|ee-|postgresql-)?(?<version>\\d+\\.\\d+\\.\\d+)$",
      changelogUrl: "https://github.com/fosrl/pangolin/releases",
    },
    {
      description: "Changelog & Release Notes for Fossorial Gerbil / Newt / Badger",
      matchDatasources: ["docker"],
      matchPackageNames: ["fosrl/gerbil", "fosrl/newt", "fosrl/badger"],
      sourceUrl: "https://github.com/{{depName}}",
    },
    {
      description: "Changelog & Release Notes for VictoriaMetrics ecosystem (victoria-metrics, vmagent, vmalert)",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^victoriametrics\\//"],
      sourceUrl: "https://github.com/VictoriaMetrics/VictoriaMetrics",
    },
    {
      description: "Changelog & Release Notes for Prometheus PVE Exporter",
      matchDatasources: ["docker"],
      matchPackageNames: ["prompve/prometheus-pve-exporter"],
      sourceUrl: "https://github.com/prometheus-pve/prometheus-pve-exporter",
    },
    {
      description: "Changelog & Release Notes for Gluetun VPN client",
      matchDatasources: ["docker"],
      matchPackageNames: ["qmcgaw/gluetun"],
      sourceUrl: "https://github.com/qdm12/gluetun",
    },
    {
      description: "Changelog & Release Notes for Umlautadaptarr",
      matchDatasources: ["docker"],
      matchPackageNames: ["pcjones/umlautadaptarr"],
      sourceUrl: "https://github.com/PCJones/Umlautadaptarr",
    },
    {
      description: "Changelog URL for 1Password Connect",
      matchPackageNames: ["/1password/"],
      changelogUrl: "https://github.com/1Password/connect/blob/main/CHANGELOG.md",
    },
    {
      description: "Changelog URL for Cloudflared",
      matchPackageNames: ["/cloudflared/"],
      sourceUrl: "https://github.com/cloudflare/cloudflared",
      changelogUrl: "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES",
    },
    {
      description: "Changelog URL for Apache Tika",
      matchPackageNames: ["/tika/"],
      sourceUrl: "https://github.com/apache/tika",
      changelogUrl: "https://github.com/apache/tika/blob/main/CHANGES.txt",
    },
    {
      description: "Changelog URL for Spegel",
      matchPackageNames: ["/spegel/"],
      sourceUrl: "https://github.com/spegel-org/spegel",
      changelogUrl: "https://github.com/spegel-org/spegel/blob/main/CHANGELOG.md",
    },
  ],
}