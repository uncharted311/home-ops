{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Victoria Metrics Group",
      groupName: "victoriaMetrics",
      matchDatasources: ["docker"],
      matchPackageNames: ["/victoria-metrics/", "/vmagent/", "/vmalert/", "/victoriametrics/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Immich Group",
      groupName: "immich",
      matchDatasources: ["docker"],
      matchPackageNames: ["/immich-server/", "/immich-machine-learning/", "immich", "immich-ai"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
  ],
}