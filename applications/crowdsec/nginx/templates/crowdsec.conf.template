upstream crowdsec_backend {
    server crowdsec:8080;
    keepalive 32;
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name crowdsec.${SECRET_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SECRET_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SECRET_CERT_NAME}/privkey.pem;

    include /etc/nginx/includes/default_ssl_params.conf;
    include /etc/nginx/includes/default_reverse_proxys.conf;
    include /etc/nginx/includes/default_header_params.conf;

    # --- Buffer Settings --- #
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # --- IP-Whitelist (Zugriffsschutz) --- #
    include /etc/nginx/admin.conf/whitelist_admin.conf;
    allow ${PUBLIC_IPv4_ZTNA};
    allow ${PUBLIC_IPv4_OC_ARM2};
    allow ${PUBLIC_IPv4_OC_AMD1};
    allow ${PUBLIC_IPv4_OC_AMD2};
    allow ${PUBLIC_IPv4_MAIL};
    allow ${PUBLIC_IPv6_ZTNA};
    allow ${PUBLIC_IPv6_OC_ARM2};
    allow ${PUBLIC_IPv6_OC_AMD1};
    allow ${PUBLIC_IPv6_OC_AMD2};
    allow ${PUBLIC_IPv6_MAIL};
    allow 172.16.0.0/12;  # Docker Bridge Network
    deny all;

    # -------------------------------
    # CrowdSec Blocklist Mirror
    # -------------------------------
    location ^~ /security/blocklist/ {
        rewrite ^/security/blocklist/?(.*)$ /$1 break;
        
        set $upstream_backend_blocklist http://crowdsec-blocklist-mirror:41412;
        proxy_pass $upstream_backend_blocklist;
        include /etc/nginx/includes/default_proxy_params.conf;
        # Timeouts (gegen die "context canceled" Fehler)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        # Deaktiviere Buffering für Echtzeit-API-Antworten
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # -------------------------------
    # CrowdSec API (OHNE Security Header)
    # -------------------------------
    location ^~ /v1/ {

        set $upstream_backend_api http://crowdsec_backend;
        proxy_pass $upstream_backend_api;
        include /etc/nginx/includes/default_proxy_params.conf;
        
        # Crowdsec Customizations
        # Zugriffsschutz
        limit_req zone=lapi_limit burst=50 nodelay;
        # Timeouts (gegen die "context canceled" Fehler)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        # Deaktiviere Buffering für Echtzeit-API-Antworten
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 50M;

        access_log off;
    }

    # ---------------------------------
    # Crowdsec WebUI Endpoint
    # ---------------------------------

    location /ui/ {
        set $upstream_backend_ui http://crowdsec-webui:3000;
        proxy_pass $upstream_backend_ui;
        include /etc/nginx/includes/default_proxy_params.conf;

        # Crowdsec WebUi Customizations
        auth_basic           "Restricted Administrator Area";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;     
        proxy_set_header Authorization "";
        client_max_body_size 50M;
        # Deaktiviere Buffering für Echtzeit-API-Antworten
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

    }

    # ---------------------------------
    # Crowdsec Endpoint
    # ---------------------------------

    location / {
        set $upstream_backend http://crowdsec_backend;
        proxy_pass $upstream_backend;
        include /etc/nginx/includes/default_proxy_params.conf;
        
        # Crowdsec Customizations
        # Zugriffsschutz
        limit_req zone=lapi_limit burst=50 nodelay;
        client_max_body_size 50M;
        client_body_buffer_size 128k;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

    }

    access_log /dev/stdout;
    error_log /dev/stderr warn;
}