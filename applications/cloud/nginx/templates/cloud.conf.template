server {
    listen 443 ssl;
    server_name cloud.srv.${SECRET_DOMAIN};
    
    ssl_certificate /etc/letsencrypt/live/${SECRET_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SECRET_CERT_NAME}/privkey.pem;

    include /etc/nginx/includes/default_ssl_params.conf;
    include /etc/nginx/includes/default_reverse_proxys.conf;
    include /etc/nginx/includes/default_header_params.conf;

    access_log /dev/stdout combined if=$loggable;
    error_log /dev/stderr;

    add_header X-Robots-Tag "noindex, nofollow" always;

    location ^~ /.well-known/carddav {
        return 301 $scheme://$host/remote.php/dav;
    }

    location ^~ /.well-known/caldav {
        return 301 $scheme://$host/remote.php/dav;
    }

    location / {
        set $upstream_backend http://nextcloud:80;
        proxy_pass $upstream_backend;
        include /etc/nginx/includes/default_proxy_params.conf;
        
        # Nextcloud Customization
        # 1. Upload-Größe & Buffering (essenziell für WebDAV/Sync)
        client_max_body_size 0;
        proxy_buffering off;
        proxy_request_buffering off;

        # 2. Timeouts für große Dateien & Syncs
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # 3. Nextcloud-spezifische Header
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Server $host;
    }
}