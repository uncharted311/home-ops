server {
    listen 443 ssl;
    server_name emby.srv.${SECRET_DOMAIN};
    
    ssl_certificate /etc/letsencrypt/live/${SECRET_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SECRET_CERT_NAME}/privkey.pem;

    include /etc/nginx/includes/default_ssl_params.conf;
    include /etc/nginx/includes/default_reverse_proxys.conf;
    include /etc/nginx/includes/default_header_params.conf;

    access_log  off;
    error_log /dev/stderr;
    
    location / {
        set $upstream_backend http://emby:8096;
        proxy_pass $upstream_backend;
        include /etc/nginx/includes/default_proxy_params.conf;
        
        # Emby Customization
        # Disable buffering to allow for real-time streaming and reduce latency
        proxy_buffering off;
        proxy_request_buffering off;
        # Disable for large file uploads and long-running requests
        client_max_body_size 0;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Disable Nginx Upstream Buffering
        proxy_set_header X-Accel-Buffering "no";
    }
}